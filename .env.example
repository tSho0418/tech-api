# .env.example — ローカル開発用環境変数テンプレート
# このファイルをコピーして .env を作成し、実際の値を設定する
# cp .env.example .env

# DB接続 (Dockerローカル)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/itnews
SPRING_DATASOURCE_USERNAME=itnews
SPRING_DATASOURCE_PASSWORD=itnews

# Gemini API
GEMINI_API_KEY=your_gemini_api_key

# LINE Messaging API
# Channel ID / Channel Secret は LINE Developers コンソールで確認（参照用）
LINE_CHANNEL_ID=your_line_channel_id
LINE_CHANNEL_SECRET=your_line_channel_secret
# Channel Access Token: LINE Developers → Messaging API → 「Channel access token」で発行
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
# 通知先の LINE User ID（LINE Developers → Your profile → User ID）
LINE_USER_ID=your_line_user_id

# セキュリティ
API_SECRET_KEY=your_random_secret_key_change_this

# CORS
FRONTEND_ORIGIN=http://localhost:3000
